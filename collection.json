    {
      "name": "Listar turnos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Response matches JSON structure\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.be.an(\"array\");\r\n\r\n    jsonData.forEach((turno) => {\r\n        pm.expect(turno).to.be.an(\"object\");\r\n\r\n        pm.expect(turno.id).to.be.a(\"number\");\r\n        pm.expect(turno.paciente).to.be.a(\"string\");\r\n        pm.expect(turno.documento).to.be.a(\"string\");\r\n        pm.expect(turno.especialidad).to.be.a(\"string\");\r\n        pm.expect(turno.medicoId).to.be.a(\"number\");\r\n        pm.expect(turno.fecha).to.be.a(\"string\");\r\n        pm.expect(turno.hora).to.be.a(\"string\");\r\n        pm.expect(turno.confirmado).to.be.a(\"boolean\");\r\n    });\r\n});"
            ]
          }
        }
      ],
